# Build outputs are generated locally and by CI. Keeping old .geode packages in
# the repository makes the multi-platform combiner treat Git LFS pointers as ZIP
# archives, so no packaged artifacts belong in source control.
build/

# Ignore platform specific build folders
build-*/

# Workspace files are user-specific
*.sublime-workspace

# ILY vscode
**/.vscode

# Local History for Visual Studio Code
.history/

